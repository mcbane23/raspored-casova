<?xml version="1.0" encoding="utf-8"?>
<!-- The bell is referenced only through an android.resource:// URI (AlarmReceiver.ensureChannels), which the
     release resource shrinker cannot see, so without this it ships as an empty entry and the channel has no sound. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/school_bell" />
